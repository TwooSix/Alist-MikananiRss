config_version = 2

[backend]
host = "127.0.0.1"  # Backend API bind address (127.0.0.1 = localhost only)
port = 26666  # Backend API listening port

[rss]
urls = []
interval_time = 300 # RSS fetch interval in seconds (default: 5 minutes)
strict = false  # Strict mode: only download entries that can be successfully renamed (requires rename_format)

[rss.filter]
exclude_patterns = []  # Regex patterns to exclude RSS entries by title (e.g. ["SP\\d+", "HEVC"])
exclude_fansub = []  # Blacklist fansub groups (exact match, e.g. ["Fansub_A", "Fansub_B"])
exclude_quality = []  # Blacklist quality levels (e.g. ["480p"])
exclude_languages = []  # Blacklist language labels. See docs for supported values.

[rss.priority]
field_order = ["fansub", "quality", "languages"]  # Field comparison order, earlier fields take precedence
fansub = []  # Fansub group priority, earlier = higher (e.g. ["Fansub_A", "Fansub_B"])
languages = []  # Language priority, earlier = higher. See docs for supported values.
quality = ["2160p", "1080p", "720p", "480p", "360p"]  # Quality priority, earlier = higher. Set [] to disable

[proxy]
http = ""  # HTTP proxy URL (e.g., "http://127.0.0.1:7890")
https = ""  # HTTPS proxy URL (e.g., "http://127.0.0.1:7890")

[downloader]
download_path = "/"
rename_format = "{anime_name} S{season:02d}E{episode:02d} {fansub} {quality} {languages}"
# `year` is the TMDB series premiere year, e.g. "{anime_name} ({year}) S{season:02d}E{episode:02d}"

[downloader.openlist]
url = "http://localhost:5244"
token = ""
offline_download_tool = "qBittorrent"  # Supported: aria2, qBittorrent, PikPak, 115 Cloud, 115 Open, 123Pan, 123 Open, SimpleHttp, Thunder, ThunderBrowser, ThunderX, Transmission

[metadata]
# Default when AI is not enabled. The recommended pipeline is ["ai", "tmdb"];
# title extraction must come before TMDB, which cannot run by itself.
pipeline = ["regex", "tmdb"]
# ai_source = "primary"  # Optional; defaults to the first [ai.sources.*] table

[metadata.tmdb]
# api_key = ""  # A built-in default is used when omitted
language = "zh-CN"

# API source example. Assistant sessions still run through the built-in Pi harness.
# [ai.sources.primary]
# type = "api"
# provider = "openai-compatible"  # or "anthropic-messages"
# api_key = "sk-xxx"
# model = "gpt-5-mini"
# base_url = "https://api.openai.com/v1"  # optional; official URL is the default

# Native agent source example.
# [ai.sources.chat]
# type = "agent"
# agent = "pi"  # pi, claude-code, or codex
# executable = "pi"  # optional
# model = ""  # optional; empty uses the agent's native configuration

[notification]
enabled = false  # Enable/disable notification system
batch_interval = 300.0  # Durable bounded batch window in seconds; 0 sends each item immediately

# Telegram bot configuration (optional)
# [[notification.bots]]
# type = "telegram"
# enabled = true
# config = { bot_token = "your_bot_token", user_id = "your_user_id" }

# PushPlus bot configuration (optional)
# [[notification.bots]]
# type = "pushplus"
# enabled = true
# config = { user_token = "your_user_token", channel = "wechat" }  # channel: wechat, webhook, cp, mail

# WeChat iLink bot notification (optional)
# Run `openlist-ani-wechat-login` first, then copy the printed values here.
# [[notification.bots]]
# type = "wechat"
# enabled = true
# config = { account_id = "bot@im.bot", token = "your_bot_token", base_url = "https://ilinkai.weixin.qq.com", home_channel = "user@im.wechat" }

# Feishu/Lark bot notification (optional)
# Start the Feishu assistant and send /set-notify-home in the target chat before notifications can be delivered.
# [[notification.bots]]
# type = "feishu"
# enabled = true
# config = { app_id = "cli_xxx", app_secret = "your_app_secret" }

[assistant]
enabled = false  # Enable/disable assistant module
# backend = "primary"  # Optional; defaults to the first [ai.sources.*] table
# skills_dir = "skills"  # Direct custom Skill path for Pi/Claude; Codex uses native plugins

# Telegram assistant configuration (optional)
[assistant.telegram]
enabled = false
bot_token = ""  # Telegram bot token from @BotFather
allowed_users = [123456789]  # Required: Telegram user IDs allowed to use Assistant

# WeChat iLink assistant configuration (optional)
# Run `openlist-ani-wechat-login` first, then copy account_id/token here.
[assistant.wechat]
enabled = false
account_id = ""
token = ""
base_url = "https://ilinkai.weixin.qq.com"
home_channel = ""  # WeChat chat_id captured by setup; assistant only accepts this conversation
allowed_users = ["user@im.wechat"]  # Required: allowed WeChat sender IDs

# Feishu/Lark assistant configuration (optional)
[assistant.feishu]
enabled = false
app_id = ""        # Feishu/Lark app ID, e.g. cli_xxx
app_secret = ""    # App Secret from the developer console
domain = "feishu"  # feishu or lark
connection_mode = "websocket"  # Keep the default unless you need webhook callbacks
webhook_host = "127.0.0.1"  # used only when connection_mode = "webhook"
webhook_port = 8765         # used only when connection_mode = "webhook"
webhook_path = "/feishu/webhook"  # used only when connection_mode = "webhook"
bot_open_id = ""   # Optional; improves group @mention detection
require_mention = true
state_dir = "data/messaging"  # Directory for /set-notify-home target
allowed_users = ["ou_xxx"] # Required: Feishu open_id/user_id allowlist

[bangumi]
access_token = ""  # Bangumi API Access Token (also supports env var BANGUMI_TOKEN)

[mikan]
username = ""  # Mikan (mikanani.me) account username
password = ""  # Mikan account password

[log]
level = "INFO"  # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
rotation = "00:00"  # Log rotation: time-based "00:00" (midnight)
retention = "1 week"  # How long to keep old logs: "1 week", "30 days", "3 months", etc.
